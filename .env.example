# ==========================================
# AURA Environment Variables Configuration
# ==========================================

# GEMINI_API_KEY: Required for Gemini 3.7 Flash AI Concierge API.
# Get key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Base URL where this application is hosted.
# Used for canonical SEO links, sitemaps, robots.txt, and OpenGraph metadata.
APP_URL="http://localhost:3000"

# DISABLE_HMR: Optional. Set to "true" in server-managed environments to disable HMR watch options.
# DISABLE_HMR="true"
